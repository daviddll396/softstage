<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Softstage</AssemblyName>
    <RootNamespace>Softstage.Mac</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Softstage.Core\Softstage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\GoogleSansFlex-Regular.ttf" />
    <AvaloniaResource Include="Assets\Fonts\GoogleSansFlex-Bold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\OFL.txt" />
    <AvaloniaResource Include="Assets\app-icon.png" />
  </ItemGroup>

</Project>
